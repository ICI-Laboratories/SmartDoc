# SmartReview Local Configuration
SMARTREVIEW_BASE=smartdoc_data
SMARTREVIEW_API_GATEWAY_URL=http://127.0.0.1:8043
SMARTDOC_PUBLIC_GATEWAY_URL=http://127.0.0.1:8043
SMARTDOC_FRONTEND_URL=http://127.0.0.1:8501/
SMARTDOC_AUTH_PORTAL_URL=http://127.0.0.1:3000
SMARTDOC_IDENTITY_URL=http://127.0.0.1:8001
SMARTDOC_AUTH_CALLBACK_URL=http://127.0.0.1:8043/auth/callback
SMARTDOC_GATEWAY_LISTEN=127.0.0.1:8043
SMARTDOC_COOKIE_SECURE=false
# Set this only when gateway and frontend use sibling production subdomains.
# SMARTDOC_COOKIE_DOMAIN=.example.com
SMARTDOC_SESSION_COOKIE_NAME=smartdoc_session
SMARTDOC_CSRF_COOKIE_NAME=smartdoc_csrf
SMARTDOC_OAUTH_TRANSACTION_TTL_SECONDS=300
SMARTREVIEW_LM_URL=http://localhost:11434/v1/chat/completions
SMARTREVIEW_MODEL=gemma3n:e2b-it-fp16
SMARTREVIEW_LM_TIMEOUT=300
SMARTREVIEW_LLM_SERVICE_URL=http://127.0.0.1:8044
SMARTREVIEW_DOC_PROCESSOR_URL=http://127.0.0.1:8045
SMARTREVIEW_GATEWAY_TIMEOUT=900
SMARTREVIEW_MAX_BODY_BYTES=104857600
SMARTREVIEW_CONTEXT_LIMIT=16000
SMARTREVIEW_MAX_PDF_BYTES=104857600
SMARTREVIEW_HTTP_TIMEOUT=300
SMARTREVIEW_SUMMARY_CONCURRENCY=2
