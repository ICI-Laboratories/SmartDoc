# Use a URL-safe random password (e.g. openssl rand -hex 24).
SARA_DB_PASSWORD=
SARA_PUBLIC_ORIGIN=http://127.0.0.1:8043
SARA_PORT=8043
SMARTDOC_COOKIE_SECURE=false
# All inference uses the authenticated gateway. Never put this key in the browser.
LLM_GATEWAY_BASE_URL=http://llm-gateway:8000/v1
LLM_GATEWAY_API_KEY=
SARA_LLM_MODEL=
# Keep auxiliaries disabled until their routes/models exist in the gateway.
SARA_EMBEDDING_MODEL=
# 1024 dimensions required. Change revision and reindex when weights, quantization,
# pooling, normalization, prompts, or backend change. Same identity for reads/writes.
SARA_EMBEDDING_REVISION=llama.cpp-v1
SARA_EMBEDDING_QUERY_INSTRUCTION=
SARA_OCR_MODEL=
SARA_OCR_PROFILE=glm-ocr
SARA_OCR_MAX_SIDE=1600
SARA_ANALYTICS_ENABLED=true
SARA_ANALYTICS_RETENTION_DAYS=90

# Optional central login; leave disabled until the SARA portal is available.
SARA_LOGIN_ENABLED=false
SMARTDOC_AUTH_PORTAL_URL=http://localhost:3000
SMARTDOC_IDENTITY_URL=http://host.docker.internal:8001
# New temporary spaces expire after 1..168 hours. Existing libraries are preserved.
SARA_EPHEMERAL_HOURS=24
