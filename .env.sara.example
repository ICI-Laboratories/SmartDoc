# Use a URL-safe random password (e.g. openssl rand -hex 24).
SARA_DB_PASSWORD=
SARA_PUBLIC_ORIGIN=http://127.0.0.1:8043
SARA_PORT=8043
SMARTDOC_COOKIE_SECURE=false
# Optional local AI. Pin the same embedding model for ingestion and retrieval.
SARA_OLLAMA_URL=http://host.docker.internal:11434
SARA_EMBEDDING_MODEL=
# Example embedding model: bge-m3 (1024 dimensions). Pre-download it on the model server.
SARA_LLM_URL=
SARA_LLM_MODEL=
# Example: http://host.docker.internal:11434/v1/chat/completions
SARA_ANALYTICS_ENABLED=true
SARA_ANALYTICS_RETENTION_DAYS=90

# Optional central login; leave disabled until the SARA portal is available.
SARA_LOGIN_ENABLED=false
SMARTDOC_AUTH_PORTAL_URL=http://localhost:3000
SMARTDOC_IDENTITY_URL=http://host.docker.internal:8001
# New temporary spaces expire after 1..168 hours. Existing libraries are preserved.
SARA_EPHEMERAL_HOURS=24
