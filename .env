SMARTREVIEW_BASE=D:\smartreview
SMARTREVIEW_LM_URL=http://localhost:1234/v1/chat/completions
SMARTREVIEW_MODEL=google/gemma-3-12b
SMARTREVIEW_LM_TIMEOUT=600

