# SmartReview Local Configuration (Ollama with limited VRAM)
# For RTX 3090 (24GB VRAM) - using smaller models to leave room for context

# Base directory for document storage
# Leave empty/commented to use platform-appropriate default:
#   Windows: %LOCALAPPDATA%\SmartReview
#   macOS: ~/Library/Application Support/SmartReview
#   Linux: ~/.local/share/SmartReview
# Or set a custom path (relative paths are resolved from project root):
# SMARTREVIEW_BASE=smartdoc_data

# Ollama endpoint (OpenAI-compatible API)
SMARTREVIEW_LM_URL=http://localhost:11434/v1/chat/completions

# Model selection - choose one:
# granite4:7b-a1b-h (4.2GB) - smallest, fastest, recommended for VRAM-constrained setups
# gemma3n:e2b-it-fp16 (8.9GB) - larger but more capable
SMARTREVIEW_MODEL=gemma3n:e2b-it-fp16

# Timeout for LLM requests (seconds) - lower models are faster
SMARTREVIEW_LM_TIMEOUT=300

# Internal service URLs (used by API Gateway on port 8043)
SMARTREVIEW_LLM_SERVICE_URL=http://127.0.0.1:8044
SMARTREVIEW_DOC_PROCESSOR_URL=http://127.0.0.1:8045

# Gateway timeout in seconds (increase for large documents - 126 pages can take 10+ minutes)
SMARTREVIEW_GATEWAY_TIMEOUT=900

# Max upload size in bytes (100MB for large PDFs)
SMARTREVIEW_MAX_BODY_BYTES=104857600

# Context token limit - reduce if running out of VRAM
# Default is 31000, use 8000-16000 for smaller context window
SMARTREVIEW_CONTEXT_LIMIT=16000

# Document processor settings for large documents
SMARTREVIEW_MAX_PDF_BYTES=104857600
SMARTREVIEW_HTTP_TIMEOUT=300
SMARTREVIEW_SUMMARY_CONCURRENCY=2
