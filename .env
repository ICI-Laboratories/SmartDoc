# ====== SmartDoc (rutas) ======
# Usuario “lógico” para organizar tus carpetas (opcional; por defecto usa el usuario del sistema)
SMARTDOC_USER=tu_nombre

# Carpeta base donde se guardará todo (elige una)
# Windows:
SMARTDOC_BASE=D:\clasdocs
# macOS / Linux (ejemplo):
# SMARTDOC_BASE=/Users/tu_usuario/SmartDocData
# SMARTDOC_BASE=/home/tu_usuario/SmartDocData


# ====== LM Studio (LLM local) ======
# Endpoint OpenAI-compatible (Developer > OpenAI Compatible Server en LM Studio)
SMARTDOC_LM_URL=http://localhost:1234/v1/chat/completions


SMARTDOC_MODEL=google/gemma-3-4b

# Tiempo máximo de espera para las llamadas al LLM (segundos)
SMARTDOC_LM_TIMEOUT=60
